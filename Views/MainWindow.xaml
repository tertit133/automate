<Window x:Class="AutoMate.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AutoMate.ViewModels"
        xmlns:m="clr-namespace:AutoMate.Models"
        Title="AutoMate -- automation studio"
        Width="1300" Height="860">

  <Window.DataContext>
    <vm:MainViewModel />
  </Window.DataContext>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="28" />
    </Grid.RowDefinitions>

    <!-- header -->
    <Border Grid.Row="0" Background="{StaticResource Panel}"
            BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1"
            Padding="12,6">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="AutoMate" FontWeight="SemiBold" FontSize="16"
                   VerticalAlignment="Center" />
        <TextBlock Text="  //  macro recorder + C# scripting + hotkeys + cron"
                   Foreground="{StaticResource Dim}" VerticalAlignment="Center" />
      </StackPanel>
    </Border>

    <!-- main content -->
    <TabControl Grid.Row="1" Margin="6">

      <!-- RECORDER -->
      <TabItem Header="Recorder">
        <Grid Margin="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <!-- left: capture -->
          <TextBlock Grid.Column="0" Grid.Row="0" Text="Record a new macro"
                     FontWeight="SemiBold" />
          <StackPanel Grid.Column="0" Grid.Row="1" Orientation="Horizontal"
                      Margin="0,6,0,6" >
            <TextBlock Text="Name:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox Width="220" Text="{Binding Recorder.MacroName, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
          <TextBlock Grid.Column="0" Grid.Row="2" Text="Notes:" />
          <TextBox   Grid.Column="0" Grid.Row="3" Height="60"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     Text="{Binding Recorder.Notes}" />
          <StackPanel Grid.Column="0" Grid.Row="4" Orientation="Horizontal"
                      Margin="0,10,0,0" VerticalAlignment="Top">
            <Button Content="Start"
                    Command="{Binding Recorder.StartRecordingCommand}" />
            <Button Content="Stop + save" Margin="6,0,0,0"
                    Command="{Binding Recorder.StopAndSaveCommand}" />
            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center"
                       Foreground="{StaticResource Dim}"
                       Text="{Binding Recorder.IsRecording, StringFormat=recording={0}}" />
            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center"
                       Foreground="{StaticResource Dim}"
                       Text="{Binding Recorder.StepCount, StringFormat=last saved: {0} steps}" />
          </StackPanel>

          <!-- right: library -->
          <TextBlock Grid.Column="1" Grid.Row="0" Text="Macro library"
                     FontWeight="SemiBold" Margin="12,0,0,0" />
          <ListBox   Grid.Column="1" Grid.Row="1" Grid.RowSpan="3" Margin="12,6,0,0"
                     ItemsSource="{Binding MacroNames}"
                     SelectedItem="{Binding Recorder.SelectedMacro}" />
          <StackPanel Grid.Column="1" Grid.Row="4" Orientation="Horizontal"
                      Margin="12,10,0,0">
            <Button Content="Play"   Command="{Binding Recorder.PlayCommand}" />
            <Button Content="Stop"   Margin="6,0,0,0" Command="{Binding Recorder.StopCommand}" />
            <Button Content="Delete" Margin="6,0,0,0" Command="{Binding Recorder.DeleteCommand}" />
          </StackPanel>
        </Grid>
      </TabItem>

      <!-- SCRIPT -->
      <TabItem Header="Script">
        <Grid Margin="12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Name:" VerticalAlignment="Center" />
            <TextBox Width="220" Margin="6,0,0,0"
                     Text="{Binding Script.Name, UpdateSourceTrigger=PropertyChanged}" />
            <Button Content="Save"  Margin="6,0,0,0" Command="{Binding Script.SaveCommand}" />
            <Button Content="Load"  Margin="6,0,0,0" Command="{Binding Script.LoadCommand}" />
            <Button Content="Run"   Margin="18,0,0,0" Command="{Binding Script.RunCommand}" />
            <Button Content="Stop"  Margin="6,0,0,0"  Command="{Binding Script.StopCommand}" />
          </StackPanel>
          <TextBox Grid.Row="1" Margin="0,8,0,0"
                   AcceptsReturn="True" AcceptsTab="True" VerticalScrollBarVisibility="Auto"
                   FontFamily="Consolas, Menlo, monospace"
                   Text="{Binding Script.Source, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock Grid.Row="2" Margin="0,6,0,0" Foreground="{StaticResource Dim}"
                     Text="Globals: Mouse / Keyboard / Screen / Log / Sleep -- see AutomationApi.cs" />
        </Grid>
      </TabItem>

      <!-- HOTKEYS -->
      <TabItem Header="Hotkeys">
        <Grid Margin="12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Mods (Ctrl/Alt/Shift/Win as uint flags):" VerticalAlignment="Center" />
            <TextBox Width="80" Margin="6,0,0,0"
                     Text="{Binding Hotkeys.EditMods, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="VK:" Margin="12,0,0,0" VerticalAlignment="Center" />
            <TextBox Width="80" Margin="6,0,0,0"
                     Text="{Binding Hotkeys.EditVk, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="Action:" Margin="12,0,0,0" VerticalAlignment="Center" />
            <ComboBox Width="160" Margin="6,0,0,0"
                      ItemsSource="{Binding Source={x:Static m:HotkeyActionValues.All}}"
                      SelectedItem="{Binding Hotkeys.EditAction}" />
            <TextBlock Text="Target:" Margin="12,0,0,0" VerticalAlignment="Center" />
            <TextBox Width="200" Margin="6,0,0,0"
                     Text="{Binding Hotkeys.EditTarget, UpdateSourceTrigger=PropertyChanged}" />
            <Button Content="+ Add" Margin="12,0,0,0" Command="{Binding Hotkeys.AddCommand}" />
          </StackPanel>

          <ListBox Grid.Row="1" Margin="0,8,0,0"
                   ItemsSource="{Binding Hotkeys.Bindings}">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="{x:Type m:HotkeyBinding}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding Display}" MinWidth="500" />
                  <Button Content="x" Margin="12,0,0,0"
                          Command="{Binding DataContext.Hotkeys.RemoveCommand,
                                              RelativeSource={RelativeSource AncestorType=Window}}"
                          CommandParameter="{Binding}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Grid.Row="2" Margin="0,6,0,0" Foreground="{StaticResource Dim}"
                     Text="Mods: Alt=1, Control=2, Shift=4, Win=8. VK is the virtual-key code (e.g. F5 = 0x74)." />
        </Grid>
      </TabItem>

      <!-- SCHEDULE -->
      <TabItem Header="Schedule">
        <Grid Margin="12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Cron:" VerticalAlignment="Center" />
            <TextBox Width="220" Margin="6,0,0,0"
                     Text="{Binding Schedule.EditCron, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="Action:" Margin="12,0,0,0" VerticalAlignment="Center" />
            <ComboBox Width="160" Margin="6,0,0,0"
                      ItemsSource="{Binding Source={x:Static m:HotkeyActionValues.All}}"
                      SelectedItem="{Binding Schedule.EditAction}" />
            <TextBlock Text="Target:" Margin="12,0,0,0" VerticalAlignment="Center" />
            <TextBox Width="200" Margin="6,0,0,0"
                     Text="{Binding Schedule.EditTarget, UpdateSourceTrigger=PropertyChanged}" />
            <Button Content="+ Add" Margin="12,0,0,0" Command="{Binding Schedule.AddCommand}" />
            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center"
                       Foreground="{StaticResource Dim}"
                       Text="{Binding Schedule.LastParse}" />
          </StackPanel>

          <DataGrid Grid.Row="1" Margin="0,8,0,0" AutoGenerateColumns="False"
                    ItemsSource="{Binding Schedule.Tasks}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Cron"    Binding="{Binding Cron}"    Width="160" />
              <DataGridTextColumn Header="Action"  Binding="{Binding Action}"  Width="140" />
              <DataGridTextColumn Header="Target"  Binding="{Binding Target}"  Width="*" />
              <DataGridCheckBoxColumn Header="On"  Binding="{Binding Enabled}" Width="40" />
            </DataGrid.Columns>
          </DataGrid>

          <TextBlock Grid.Row="2" Margin="0,6,0,0" Foreground="{StaticResource Dim}"
                     Text="Cron: minute hour dayOfMonth month dayOfWeek. Supports * */n a,b a-b." />
        </Grid>
      </TabItem>

      <!-- LOG -->
      <TabItem Header="Log">
        <TextBox Margin="12" IsReadOnly="True"
                 VerticalScrollBarVisibility="Auto"
                 FontFamily="Consolas, Menlo, monospace"
                 Text="{Binding Log.Text, Mode=OneWay}" />
      </TabItem>

    </TabControl>

    <!-- status bar -->
    <Border Grid.Row="2" Background="{StaticResource Panel}"
            BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0"
            Padding="12,4">
      <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource Dim}" FontSize="12" />
    </Border>

  </Grid>
</Window>
